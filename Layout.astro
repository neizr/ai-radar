---
const { title = "AI Radar — Find the right AI tool" } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="AI Radar — découvre, compare et choisis les meilleurs outils IA." />
    <title>{title}</title>
    <style is:global>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: #07080c; color: #f7f8fb; }
      button, input { font: inherit; }
      a { color: inherit; text-decoration: none; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
